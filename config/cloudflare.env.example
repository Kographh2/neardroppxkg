# Copy values into .env locally and Vercel Production environment variables.
# Never prefix these secrets with NEXT_PUBLIC_. Redeploy after changing Vercel env.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
